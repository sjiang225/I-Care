# ===== I-Care backend configuration =====
# Copy this file to ".env" and fill in real values.

# --- LLM provider ---
# Options: "mock" (no API key needed, for local dev) | "openai"
# To switch to a self-hosted small model later (vLLM / Ollama / TGI with an
# OpenAI-compatible API), keep LLM_PROVIDER=openai and just point
# OPENAI_BASE_URL at your own server + set the model name. No code change needed.
LLM_PROVIDER=mock

# Chat model
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model (used by RAG later)
OPENAI_EMBED_MODEL=text-embedding-3-small
# Knowledge base built with the embed model above (see scripts/reembed_kb.py).
KB_DB_PATH=data/kb.sqlite3
# Thinking level for reasoning models (e.g. Gemini "none"/"low"); leave empty for gpt-4o-mini.
OPENAI_REASONING_EFFORT=

# --- Gemini via its OpenAI-compatible endpoint (keep LLM_PROVIDER=openai) ---
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=<Gemini API key from Google AI Studio>
# OPENAI_CHAT_MODEL=gemini-3.8-flash
# OPENAI_EMBED_MODEL=gemini-embedding-001
# KB_DB_PATH=data/kb.gemini.sqlite3
# OPENAI_REASONING_EFFORT=low

# --- Server ---
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Example only. Enter the same provider/model settings used by the working local app.
# Never publish or paste your real API key into chat.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=
KB_DB_PATH=data/kb.openai.sqlite3
RAG_TOP_K=4
CORS_ORIGINS=https://icarebridge.org,https://www.icarebridge.org
# The service installer sets APP_DB_PATH to ~/icare-data/app.sqlite3.
# For Gemini, use the appropriate OpenAI-compatible endpoint and matching models,
# and KB_DB_PATH=data/kb.gemini.sqlite3 (gemini-embedding-001).
